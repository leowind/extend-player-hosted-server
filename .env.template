AB_BASE_URL=https://stage.accelbyte.io
AB_CLIENT_ID=
AB_CLIENT_SECRET=
AB_NAMESPACE=
PLUGIN_GRPC_SERVER_AUTH_ENABLED=true

PLAYERHOSTED_REG_PORT=8081                                  # Port for the player-hosted host registration HTTP server
PLAYERHOSTED_REG_TIMEOUT=120s                              # How long to wait for a host to register before failing the DS request
PLAYERHOSTED_HEARTBEAT_TIMEOUT=60s                         # Report DS_ERROR if no heartbeat is received within this window
PLAYERHOSTED_HEARTBEAT_INTERVAL=15s                        # How often the heartbeat monitor checks for stale hosts
PLAYERHOSTED_REACHABILITY_TIMEOUT=5s                       # TCP dial timeout when probing a registered host address
PLAYERHOSTED_HOSTLESS_SESSION_TIMEOUT=10m                  # Delete the AGS session after it has had no live host this long (0 disables)
PLAYERHOSTED_EMPTY_SESSION_TIMEOUT=30m                     # Delete an AVAILABLE AGS session with no JOINED/CONNECTED members this long (0 disables)

# --- Player-hosted end-to-end demo (cmd/demo-setup, cmd/demo-ds, cmd/demo-client) ---
DEMO_CONFIG_NAME=player-hosted-demo                         # Session configuration template name the demo creates/uses
DEMO_MAX_PLAYERS=10                                         # maxPlayers for the demo template
DEMO_CLIENT_VERSION=1.0.0                                   # clientVersion for the demo template
DEMO_DEPLOYMENT=player-hosted                               # deployment for the demo template
DEMO_ASYNC_TIMEOUT=120                                      # asyncProcessDSRequest timeout in seconds (must be 0 < t <= 600)
DEMO_PERSISTENT=true                                        # persistent session; set false only for an older AGS that rejects async+persistent
DEMO_APP_NAME=                                              # Deployed Extend app name (AGS resolves it via CSM); set this OR DEMO_CUSTOM_URL_GRPC
DEMO_CUSTOM_URL_GRPC=                                       # Direct gRPC URL to the Extend app (e.g. a tunnel to a locally-run app)
DEMO_HOST_USERNAME=                                         # Host player (runs demo-ds; becomes the session leader)
DEMO_HOST_PASSWORD=
DEMO_JOINER_USERNAME=                                       # Joining player (runs demo-client)
DEMO_JOINER_PASSWORD=
DEMO_REG_URL=http://localhost:8081                          # Base URL of the Extend app's registration server (PLAYERHOSTED_REG_PORT)
DEMO_DS_IP=127.0.0.1                                        # Address the demo-ds advertises (must be reachable by the Extend app)
DEMO_DS_PORT=7777                                           # Port the demo-ds game server listens on
DEMO_SERVER_ID=demo-host-1                                  # serverId reported at registration
DEMO_HEARTBEAT_INTERVAL=15s                                # How often demo-ds heartbeats (keep below PLAYERHOSTED_HEARTBEAT_TIMEOUT)
DEMO_POLL_INTERVAL=3s                                       # How often demo-client polls the session for DS AVAILABLE

